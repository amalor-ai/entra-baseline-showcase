{
  "$schema": "./client-config.schema.json",
  "client": "contoso-gruppe",
  "tenantId": "00000000-0000-0000-0000-000000000000",
  "baselineVersion": "0.1",
  "packs": ["BreakGlass", "ConditionalAccess", "Delegation"],
  "breakGlass": {
    "accounts": ["bg01@contoso.onmicrosoft.com", "bg02@contoso.onmicrosoft.com"],
    "exclusionGroupId": "11111111-1111-1111-1111-111111111111"
  },
  "conditionalAccess": {
    "enforce": ["CA002"]
  },
  "delegation": {
    "administrativeUnits": [
      {
        "name": "Site-Leipzig",
        "description": "Users of the Leipzig company",
        "dynamicRule": "(user.companyName -eq \"Contoso Leipzig GmbH\")",
        "roles": [
          { "role": "Helpdesk Administrator", "principalId": "22222222-2222-2222-2222-222222222222" }
        ]
      },
      {
        "name": "Protected-Accounts",
        "description": "Executives and break-glass accounts. Only AU-scoped admins can change them.",
        "restricted": true
      }
    ]
  }
}
